{
  "schemaVersion": "1.0.0",
  "purpose": "Discover and reconcile evidence for pre-race study. A listed source is not proof that every field is available or licensed for automated reuse.",
  "policy": {
    "useOnlyPublicOrAuthorisedAccess": true,
    "respectTermsRobotsRateLimitsAndCopyright": true,
    "noLoginBypassOrAntiBotCircumvention": true,
    "preserveSourceUrlRetrievedAtAndRawRecordReference": true,
    "missingValues": "null_with_reason",
    "unverifiedValues": "quarantined_not_scored",
    "identityMatching": "officialHorseId_preferred; otherwise exact_name_plus_pedigree_and_context; ambiguous_matches_require_review",
    "neverInferIndividualHorseTimeFromRaceTime": true,
    "noSelectionsUntilEvidenceThresholdMet": true,
    "crossSourceVerification": true,
    "authorityByFactType": {
      "fixtures": "official_racing_club",
      "declarations_and_withdrawals": "official_racing_club",
      "handicaps_and_official_ratings": "official_racing_club",
      "results_and_stewards_incidents": "official_racing_club",
      "trackwork": "official_club_when_published_then_independent_publisher_cross_check",
      "jockey_trainer_statistics": "source_with_complete_defined_sample_and_verified_runner_or_person_identity",
      "pedigree": "authorised_studbook_or_verified_pedigree_record",
      "weather": "authoritative_observation_provider"
    },
    "conflicts": "retain_each_source_record; compare timestamps and authority; flag disagreement; never silently choose or merge",
    "sourceHealth": "test each registered source independently for reachability, relevant page discovery, date coverage, data availability, freshness and access permission; unavailable is not evidence of no record"
  },
